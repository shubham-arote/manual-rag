# ── LLM Provider ─────────────────────────────────────────────────
# Use ONE of the following:

# Option A: Groq (fastest free tier, generous daily limits)
GROQ_API_KEY=your-groq-key-here

# Option B: OpenRouter (broadest model choice, pay-per-use)
OPENROUTER_API_KEY=your-openrouter-key-here

# ── Model Config ─────────────────────────────────────────────────
# Three-client split — each step uses the cheapest model that produces
# good results for that task, saving ~40-60% vs. running everything
# through a single expensive vision model.

# VISION_MODEL — complex multi-image reasoning (context step only)
#   Receives current page image + neighboring text for section/model detection.
#   Needs strong vision capability.
# Groq best free-tier option:
VISION_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter upgrade (better accuracy, ~$0.10/1M tokens):
# VISION_MODEL=openrouter/google/gemini-2.0-flash-exp

# METADATA_MODEL — single-image tasks (table correction, table & image metadata)
#   One image per call, structured JSON output.  Can use a cheaper/faster model.
#   Defaults to VISION_MODEL if unset.
# Groq (uses VISION_MODEL automatically — no need to set separately):
# METADATA_MODEL=groq/meta-llama/llama-4-scout-17b-16e-instruct
# OpenRouter cheaper option (8B — fast & cheap for single-image tasks):
# METADATA_MODEL=openrouter/google/gemini-flash-1.5-8b

# TEXT_MODEL — text-only tasks (table flattening, answer generation)
#   No images — pure text reasoning.  A good large text model is preferred.
# Groq:
TEXT_MODEL=groq/llama-3.3-70b-versatile
# OpenRouter alternative:
# TEXT_MODEL=openrouter/google/gemini-2.0-flash-exp
